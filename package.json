{
  "name": "daily-app-factory",
  "version": "0.1.0",
  "private": true,
  "description": "日刊アプリ工房 - DeepSeek V4 が毎日 1 本の単一 HTML アプリを生成・検証・公開する自律サービス",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "generate": "node scripts/generate.mjs",
    "verify": "node scripts/verify-app.mjs",
    "feedback": "node scripts/feedback.mjs",
    "thumbs": "node scripts/make-thumbs.mjs",
    "seed:local": "node scripts/seed.mjs --local",
    "seed": "node scripts/seed.mjs",
    "dev:gallery": "wrangler dev --local --config workers/gallery/wrangler.toml --port 8787",
    "deploy": "wrangler deploy --config workers/gallery/wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
